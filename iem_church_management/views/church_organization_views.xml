            ref('iem_church_management.group_iem_pastor_gobierno'),
            ref('iem_church_management.group_iem_pastor')
        ])]" />
    </record>

    <menuitem
        id="menu_church_membership_config"
        name="Configuracion"
        parent="menu_church_membership_root"
        sequence="20"
        groups="base.group_user"
    />
    <menuitem
        id="menu_church_membership_predio"
        name="Predios"
        parent="menu_church_membership_config"
        action="action_iem_church_predio"
        sequence="10"
        groups="base.group_system,iem_church_management.group_iem_admin,iem_church_management.group_iem_pastor_gobierno,iem_church_management.group_iem_pastor"
    />
    <menuitem
        id="menu_church_membership_red"
