                            <field name="lider_id" options="{'no_create': True, 'no_create_edit': True}" />
                            <field name="active" />
                        </group>
                        <group string="Direccion">
                            <field name="country_id" string="Pais" options="{'no_create': True}" />
                            <field name="state_id" string="Provincia" options="{'no_create': True}" />
                            <field name="city" string="Ciudad" />
                            <field name="zip" string="Codigo Postal" />
                            <field name="street" string="Calle" />
                            <field name="latitude" />
                            <field name="longitude" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_iem_church_celula" model="ir.actions.act_window">
        <field name="name">Celulas</field>
        <field name="res_model">iem.church.celula</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_iem_church_celula_list" />
        <field name="groups_id" eval="[(6, 0, [
