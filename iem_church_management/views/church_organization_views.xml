<odoo>
    <record id="view_iem_church_predio_list" model="ir.ui.view">
        <field name="name">iem.church.predio.list</field>
        <field name="model">iem.church.predio</field>
        <field name="arch" type="xml">
            <list string="Predios">
                <field name="name" />
                <field name="pastor_id" />
                <field name="phone" />
                <field name="email" />
                <field name="city" />
                <field name="state_id" />
                <field name="country_id" />
                <field name="active" />
            </list>
        </field>
    </record>

    <record id="view_iem_church_predio_form" model="ir.ui.view">
        <field name="name">iem.church.predio.form</field>
        <field name="model">iem.church.predio</field>
        <field name="arch" type="xml">
            <form string="Predio">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="pastor_id" options="{'no_create': True, 'no_create_edit': True}" />
                            <field name="phone" />
                            <field name="email" />
                            <field name="active" />
                        </group>
                        <group string="Direccion">
                            <field name="country_id" string="Pais" options="{'no_create': True}" />
                            <field name="state_id" string="Provincia" options="{'no_create': True}" />
                            <field name="city" string="Ciudad" />
                            <field name="zip" string="Codigo Postal" />
                            <field name="street" string="Calle" />
                            <field name="latitude" />
                            <field name="longitude" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_iem_church_predio" model="ir.actions.act_window">
        <field name="name">Predios</field>
        <field name="res_model">iem.church.predio</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_iem_church_predio_list" />
        <field name="groups_id" eval="[(6, 0, [
            ref('base.group_system'),
            ref('iem_church_management.group_iem_admin'),
            ref('iem_church_management.group_iem_pastor_gobierno'),
            ref('iem_church_management.group_iem_pastor')
        ])]" />
    </record>

    <record id="view_iem_church_red_list" model="ir.ui.view">
        <field name="name">iem.church.red.list</field>
        <field name="model">iem.church.red</field>
        <field name="arch" type="xml">
            <list string="Redes">
                <field name="name" />
                <field name="predio_id" />
                <field name="pastor_id" />
                <field name="active" />
            </list>
        </field>
    </record>

    <record id="view_iem_church_red_form" model="ir.ui.view">
        <field name="name">iem.church.red.form</field>
        <field name="model">iem.church.red</field>
        <field name="arch" type="xml">
            <form string="Red">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="predio_id" options="{'no_create': True, 'no_create_edit': True}" />
                            <field name="pastor_id" options="{'no_create': True, 'no_create_edit': True}" />
                            <field name="active" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_iem_church_red" model="ir.actions.act_window">
        <field name="name">Redes</field>
        <field name="res_model">iem.church.red</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_iem_church_red_list" />
        <field name="groups_id" eval="[(6, 0, [
            ref('base.group_system'),
            ref('iem_church_management.group_iem_admin'),
            ref('iem_church_management.group_iem_pastor_gobierno'),
            ref('iem_church_management.group_iem_pastor')
        ])]" />
    </record>

    <record id="view_iem_church_discipulado_list" model="ir.ui.view">
        <field name="name">iem.church.discipulado.list</field>
        <field name="model">iem.church.discipulado</field>
