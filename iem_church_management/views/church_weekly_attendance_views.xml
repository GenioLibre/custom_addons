<odoo>
    <record id="view_iem_weekly_attendance_list" model="ir.ui.view">
        <field name="name">iem.church.weekly.attendance.list</field>
        <field name="model">iem.church.weekly.attendance</field>
        <field name="arch" type="xml">
            <list string="Asistencia semanal">
                <field name="week_year" />
                <field name="week_number" />
                <field name="week_start" />
                <field name="week_end" />
                <field name="celula_id" />
                <field name="discipulado_id" />
                <field name="red_id" />
                <field name="predio_id" />
            </list>
        </field>
    </record>

    <record id="view_iem_weekly_attendance_form" model="ir.ui.view">
        <field name="name">iem.church.weekly.attendance.form</field>
        <field name="model">iem.church.weekly.attendance</field>
        <field name="arch" type="xml">
            <form string="Asistencia semanal">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="celula_id" options="{'no_create': True, 'no_create_edit': True}" />
                            <field name="week_year" />
                            <field name="week_number" />
                        </group>
                        <group>
                            <field name="week_start" />
                            <field name="week_end" />
                            <field name="predio_id" readonly="1" />
                            <field name="red_id" readonly="1" />
                            <field name="discipulado_id" readonly="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Miembros">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="member_id" options="{'no_create': True, 'no_create_edit': True}" />
                                    <field name="attended_celula" />
                                    <field name="attended_discipulado" />
                                    <field name="attended_culto" />
                                    <field name="tithed" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_iem_weekly_attendance_search" model="ir.ui.view">
        <field name="name">iem.church.weekly.attendance.search</field>
        <field name="model">iem.church.weekly.attendance</field>
        <field name="arch" type="xml">
            <search string="Buscar asistencia semanal">
                <field name="celula_id" />
                <field name="week_year" />
                <field name="week_number" />
                <group expand="0" string="Agrupar por">
                    <filter string="Célula" name="group_celula" context="{'group_by': 'celula_id'}" />
                    <filter string="Semana" name="group_week" context="{'group_by': 'week_number'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_iem_weekly_attendance" model="ir.actions.act_window">
        <field name="name">Asistencia semanal</field>
        <field name="res_model">iem.church.weekly.attendance</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_iem_weekly_attendance_list" />
        <field name="search_view_id" ref="view_iem_weekly_attendance_search" />
        <field name="groups_id" eval="[(6, 0, [
            ref('base.group_system'),
            ref('iem_church_management.group_iem_admin'),
            ref('iem_church_management.group_iem_pastor_gobierno'),
            ref('iem_church_management.group_iem_pastor'),
            ref('iem_church_management.group_iem_discipulador')
        ])]" />
    </record>

    <menuitem
        id="menu_iem_weekly_attendance"
        name="Asistencia semanal"
        parent="menu_church_membership_root"
        action="action_iem_weekly_attendance"
        sequence="15"
        groups="base.group_system,iem_church_management.group_iem_admin,iem_church_management.group_iem_pastor_gobierno,iem_church_management.group_iem_pastor,iem_church_management.group_iem_discipulador"
    />
</odoo>
