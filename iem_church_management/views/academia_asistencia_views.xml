<odoo>
    <record id="academia_view_asistencia_list" model="ir.ui.view">
        <field name="name">academia.asistencia.list</field>
        <field name="model">academia.asistencia</field>
        <field name="arch" type="xml">
            <list string="Asistencia">
                <field name="name" />
                <field name="attendance_date" />
                <field name="inscripcion_id" />
                <field name="curso_id" />
                <field name="materia_id" />
                <field name="clase_id" />
            </list>
        </field>
    </record>

    <record id="academia_view_asistencia_form" model="ir.ui.view">
        <field name="name">academia.asistencia.form</field>
        <field name="model">academia.asistencia</field>
        <field name="arch" type="xml">
            <form string="Cuadro de asistencia">
                <sheet>
                    <group>
                        <group>
                            <field name="attendance_date" />
                            <field name="inscripcion_id" />
                            <field name="curso_id" readonly="1" />
                        </group>
                        <group>
                            <field name="materia_id" />
                            <field name="clase_id" />
                        </group>
                    </group>
                    <group string="Lista de asistencia">
                        <field name="line_ids">
                            <list editable="bottom" string="Asistencia">
                                <field name="member_id" string="Miembro" options="{'no_create': True, 'no_create_edit': True}" />
                                <field name="predio_id" />
                                <field name="red_id" />
                                <field name="discipulado_id" />
                                <field name="present" />
                                <field name="note" />
                            </list>
                            <form string="Asistencia">
                                <group>
                                    <field name="member_id" options="{'no_create': True, 'no_create_edit': True}" />
                                    <field name="predio_id" readonly="1" />
                                    <field name="red_id" readonly="1" />
                                    <field name="discipulado_id" readonly="1" />
                                    <field name="present" />
                                    <field name="note" />
                                </group>
                            </form>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="academia_view_asistencia_search" model="ir.ui.view">
        <field name="name">academia.asistencia.search</field>
        <field name="model">academia.asistencia</field>
        <field name="arch" type="xml">
            <search string="Buscar asistencia">
                <field name="name" />
                <field name="inscripcion_id" />
                <field name="curso_id" />
                <field name="materia_id" />
                <field name="clase_id" />
                <field name="attendance_date" />
            </search>
        </field>
    </record>

    <record id="academia_action_asistencia" model="ir.actions.act_window">
        <field name="name">Asistencia</field>
        <field name="res_model">academia.asistencia</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="academia_view_asistencia_list" />
        <field name="search_view_id" ref="academia_view_asistencia_search" />
        <field name="groups_id" eval="[(6, 0, [
            ref('base.group_system'),
            ref('iem_church_management.group_iem_admin'),
            ref('iem_church_management.group_iem_pastor_gobierno'),
            ref('iem_church_management.group_iem_pastor')
        ])]" />
    </record>

    <menuitem
        id="academia_menu_asistencia"
        name="Asistencia"
        parent="menu_iem_academy_root"
        action="academia_action_asistencia"
        sequence="30"
        groups="base.group_system,iem_church_management.group_iem_admin,iem_church_management.group_iem_pastor_gobierno,iem_church_management.group_iem_pastor"
    />
</odoo>
