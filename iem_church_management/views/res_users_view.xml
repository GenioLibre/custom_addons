<odoo>
    <record id="view_res_users_simple_form_inherit_iem_church_hide_labels" model="ir.ui.view">
        <field name="name">res.users.simple.form.inherit.iem.church.hide.labels</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_simple_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='image_1920']" position="before">
                <label for="image_1920" invisible="1"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]/label[@for='name']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_res_users_form_inherit_iem_church_hide_labels" model="ir.ui.view">
        <field name="name">res.users.form.inherit.iem.church.hide.labels</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='image_1920']" position="before">
                <label for="image_1920" invisible="1"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]/label[@for='name']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
