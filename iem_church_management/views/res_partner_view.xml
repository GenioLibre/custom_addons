<odoo>
    <record id="contacts.menu_contacts" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [
            ref('base.group_system')
        ])]" />
    </record>

    <record id="base.menu_apps" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [
            ref('base.group_system')
        ])]" />
    </record>

    <record id="base.menu_module_tree" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [
            ref('base.group_system')
        ])]" />
    </record>

    <record id="base.open_module_tree" model="ir.actions.act_window">
        <field name="groups_id" eval="[(6, 0, [
            ref('base.group_system')
        ])]" />
    </record>

    <record id="base.menu_management" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [
            ref('base.group_system')
        ])]" />
    </record>

    <record id="base.menu_third_party" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [
            ref('base.group_system')
        ])]" />
    </record>

    <record id="base.menu_theme_store" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [
            ref('base.group_system')
        ])]" />
    </record>

    <record id="view_partner_form_inherit_iem_church" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.iem.church</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="is_member" />
            </xpath>
        </field>
    </record>
</odoo>
