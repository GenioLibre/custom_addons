<odoo>
    <record id="paperformat_church_member_registration" model="report.paperformat">
        <field name="name">Ficha de Registro A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <record id="action_report_church_member_registration" model="ir.actions.report">
        <field name="name">Ficha de Registro</field>
        <field name="model">church.member</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">iem_church_management.report_church_member_registration</field>
        <field name="report_file">iem_church_management.report_church_member_registration</field>
        <field name="paperformat_id" ref="iem_church_management.paperformat_church_member_registration"/>
        <field name="binding_model_id" ref="iem_church_management.model_church_member"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Ficha de Registro - %s' % (object.display_name or 'Miembro')</field>
    </record>
</odoo>
