<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.view.form.inherit.sale.product.image</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']"
                   position="before">
                <field name="is_image_true" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_template_id']"
                   position="after">
                <field name="order_line_image" widget="image" readonly="1" column_invisible="not parent.is_image_true"
                       options="{'size': [100, 100]}"/>

            </xpath>
            <xpath expr="//page[@name='order_lines']" position="after">
                <page string="Detalles del Pedido" name="detalles_camisetas">
                    <group>
                        <field name="archivo_excel" filename="archivo_nombre"/>
                        <button string="Importar Excel" type="object" name="importar_excel" class="btn-secondary"/>
                        <button string="Eliminar contenido importado"
                                type="object"
                                name="action_clear_imported_excel"
                                class="btn-danger"
                                confirm="¿Desea eliminar el archivo importado y todo su contenido?"
                                invisible="not excel_headers"/>
                    </group>
                    <field name="excel_headers" invisible="1"/>
                    <field name="excel_imported_filename" readonly="1" invisible="not excel_imported_filename"/>
                    <field name="excel_preview_html" widget="html" readonly="1" nolabel="1"/>

                </page>
                <page string="Mockup" name="foto_camiseta">
                    <group>
                        <div style="max-width: 512px; max-height: 100%;">
                            <field name="camiseta_foto_ids" string="Agregar Mockup"
                                   widget="many2many_binary"
                                   context="{'default_res_model': 'sale.order', 'default_res_id': id}"
                                   domain="[('res_model', '=', 'sale.order'), ('res_id', '=', id)]"
                                   options="{'accepted_file_extensions': '.jpeg,.jpg,.png'}"/>
                        </div>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
    <record id="view_camiseta_registro_list" model="ir.ui.view">
        <field name="name">camiseta.registro.tree</field>
        <field name="model">camiseta.registro</field>
        <field name="arch" type="xml">
            <list string="Detalle de Camisetas">
                <field name="diseno"/>
                <field name="nombre_en_camiseta"/>
                <field name="numero"/>
                <field name="tipo"/>
                <field name="talla_camiseta"/>
                <field name="modelo"/>
                <field name="corte"/>
                <field name="manga"/>
                <field name="cuello"/>
                <field name="tipo_short"/>
                <field name="talla_short"/>
                <field name="notas"/>
            </list>
        </field>
    </record>

</odoo>
