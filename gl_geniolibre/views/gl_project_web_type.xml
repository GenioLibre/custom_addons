<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_gl_project_web_type_tree" model="ir.ui.view">
            <field name="name">gl.project.web.type.tree</field>
            <field name="model">gl.project.web.type</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="view_gl_project_web_type_form" model="ir.ui.view">
            <field name="name">gl.project.web.type.form</field>
            <field name="model">gl.project.web.type</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="xml_template" widget="text" placeholder="Pega aquí la plantilla XML de la hoja de ruta"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_gl_project_web_type" model="ir.actions.act_window">
            <field name="name">Tipos de Web</field>
            <field name="res_model">gl.project.web.type</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_gl_project_web_type"
                  name="Tipos de Web"
                  parent="project.menu_project_config"
                  action="action_gl_project_web_type"
                  sequence="95"/>
    </data>
</odoo>
