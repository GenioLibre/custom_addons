<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="gl_geniolibre_post_image" model="ir.ui.view">
            <field name="name">Post Image</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_form2"/>
            <field name="arch" type="xml">

                <xpath expr="//page[@name='description_page']" position="replace">
                    <page name="description_page" string="Description">
                        <group>
                            <field name="objetivo" invisible="tipo == 'otro' "/>
                            <field name="description" type="html" options="{'collaborative': true, 'resizable': true}"
                                   placeholder="Texto en la descripcion del post..."/>
                            <field name="hashtags" invisible="tipo == 'otro' "/>
                            <field name="texto_en_diseno" type="html"
                                   options="{'collaborative': true, 'resizable': true}"
                                   placeholder="Texto que se usará en el diseño..." invisible="tipo == 'otro' "/>
                        </group>
                    </page>
                    <page string="Publicación Paga" invisible="tipo == 'otro'">
                        <group>
                            <field name="inicio_promocion"/>
                            <field name="fin_promocion"/>
                            <field name="presupuesto"/>
                            <field name="currency_id" String="Moneda"/>
                            <field name="activar_publicidad_paga"
                                   readonly="post_estado != 'Publicado' and not activar_publicidad_paga"/>
                            <field name="marketing_state" widget="badge"
                                   decoration-muted="not marketing_state or marketing_state == 'por_publicitar'"
                                   decoration-success="marketing_state == 'publicado'"
                                   decoration-warning="marketing_state == 'pausado'"
                                   decoration-info="marketing_state == 'terminado'"/>
                            <field name="marketing_record_id" readonly="1"/>
                        </group>
                    </page>

                </xpath>
                <xpath expr="//h1" position="replace" mode="inner">

                    <widget name="web_ribbon" bg_color="text-bg-warning" title="Programado"
                            invisible="post_estado != 'Programado'"/>

                    <widget name="web_ribbon" bg_color="text-bg-info" title="Procesando"
                            invisible="post_estado != 'Procesando'"/>

                    <widget name="web_ribbon" bg_color="text-bg-primary" title="Revisando"
                            invisible="post_estado != 'Revisando'"/>

                    <widget name="web_ribbon" bg_color="text-bg-success" title="Publicado"
                            invisible="post_estado != 'Publicado'"/>

                    <widget name="web_ribbon" bg_color="text-bg-danger" title="Error"
                            invisible="post_estado != 'Error'"/>

                    <div class="d-flex w-100">
                        <field name="priority" widget="priority_switch" class="me-3"/>
                        <field name="name" options="{'line_breaks': False}" widget="text"
                               class="o_task_name text-truncate w-md-75 w-100 pe-2" placeholder="Task Title..."/>
                    </div>
                </xpath>
                <xpath expr="//page[@name='description_page']" position="after">
                    <page string="Publicar en TikTok"
                          name="tiktok_publish_page"
                          invisible="tipo == 'otro' or not has_tiktok">
                        <group>
                            <group>
                                <button string="Actualizar"
                                        type="object"
                                        name="action_refresh_tiktok_tab"
                                        class="btn-primary"
                                        icon="fa-refresh"/>
                            </group>
                            <group>
                            </group>
                        </group>
                        <group string="Cuenta TikTok">
                            <group>
                                <field name="tiktok_nickname" readonly="1" force_save="1"/>
                                <field name="tiktok_creator_username" readonly="1" force_save="1"/>
                                <field name="tiktok_avatar_proxy_url" string="TikTok Avatar"
                                       widget="image_url"
                                       force_save="1"
                                       options="{'size': [50, 50]}"/>
                                <field name="tiktok_can_publish" readonly="1" force_save="1"/>
                                <field name="tiktok_can_publish_reason" readonly="1" force_save="1"/>
                            </group>
                            <group>
                                <field name="tiktok_max_video_post_duration_sec" readonly="1" force_save="1"/>
                                <field name="tiktok_video_duration" readonly="1"/>
                            </group>
                        </group>
                        <group string="Contenido para TikTok">
                            <group>
                                <field name="tiktok_title"
                                       readonly="1"
                                       help="TikTok tomara como titulo base el nombre actual de la tarea."/>
                                <field name="tiktok_is_aigc"/>
                                <field name="tiktok_creator_status_info"
                                       widget="text"
                                       readonly="1"
                                       force_save="1"
                                       placeholder="El caption que se enviara a TikTok se toma de Descripcion + Hashtags. Editalo desde la pestana principal del post."/>
                            </group>
                        </group>
                        <group string="Privacidad TikTok">
                            <group>
                                <field name="tiktok_privacy_level_options" widget="text" readonly="1" force_save="1"
                                       placeholder="Aqui se mostraran las opciones de privacidad devueltas por TikTok."/>
                                <field name="tiktok_allowed_privacy_option_ids" invisible="1"/>
                                <field name="tiktok_privacy_level" invisible="1"/>
                                <field name="tiktok_privacy_option_id"
                                       readonly="not tiktok_can_publish"
                                       placeholder="Selecciona manualmente la privacidad para este post."/>
                                <field name="tiktok_privacy_note" widget="text" readonly="1" force_save="1"/>
                            </group>
                            <group>
                                <field name="tiktok_allow_comments" readonly="tiktok_comment_disabled"/>
                                <field name="tiktok_allow_duet" readonly="tiktok_duet_disabled"/>
                                <field name="tiktok_allow_stitch" readonly="tiktok_stitch_disabled"/>
                            </group>
                        </group>
                        <group string="Disclosure Comercial">
                            <group>
                                <field name="tiktok_is_commercial"/>
                                <field name="tiktok_commercial_your_brand" readonly="not tiktok_is_commercial"/>
                                <field name="tiktok_commercial_branded"
                                       readonly="not tiktok_is_commercial or tiktok_privacy_level == 'SELF_ONLY'"/>
                                <field name="tiktok_commercial_label_preview" readonly="1" force_save="1"/>
                            </group>
                            <group>
                                <field name="tiktok_comment_disabled" readonly="1" force_save="1"/>
                                <field name="tiktok_duet_disabled" readonly="1" force_save="1"/>
                                <field name="tiktok_stitch_disabled" readonly="1" force_save="1"/>
                            </group>
                        </group>
                        <group string="Confirmacion TikTok">
                            <group>
                                <field name="tiktok_declaration_text" widget="text" readonly="1" force_save="1"
                                       placeholder="Aqui se mostrara la declaracion legal de TikTok."/>
                            </group>
                            <group>
                                <field name="tiktok_legal_text" widget="text" readonly="1" force_save="1"/>
                                <field name="tiktok_commercial_label_info" readonly="1" force_save="1"/>
                            </group>
                        </group>
                    </page>
                </xpath>
                <xpath expr="//page[@name='description_page']" position="after">
                    <page string="Archivos de la Tarea" invisible="tipo == 'otro' ">
                        <group>
                            <group>
                                <field name="adjuntos_ids" widget="many2many_binary"
                                       options="{'no_create': True , 'accepted_file_extensions': '.jpeg,.jpg,.mp4'}"/>
                                <field name="tiktok_video_duration"/>
                            </group>
                            <group>
                                <field name="imagen_portada" widget="image" accept=".jpg,.jpeg,image/jpeg"/>
                            </group>
                        </group>
                    </page>
                </xpath>
                <!---  Requisitos TIKTOK-->

                <xpath expr="//group/group[2]" position="inside">
                    <field name="tipo" widget="selection" readonly="post_estado != 'Pendiente'"/>
                    <field name="fecha_publicacion" readonly="post_estado != 'Pendiente'" invisible="tipo == 'otro' "/>
                    <field name="red_social_ids" readonly="post_estado != 'Pendiente'" widget="many2many_tags"
                           options="{'no_create_edit': True}" invisible="tipo == 'otro' "/>
                    <div class="row container">
                        <div class="col-12 p-0 me-3 mt-3">
                            <button string="Programar" icon="fa-calendar" type="object" name="programar_post"
                                    class="btn-primary mr4"
                                    invisible="post_estado != 'Pendiente' or tipo =='otro' or state!= '03_approved'"/>
                            <button string="Publicar" icon="fa-check" type="object" name="publicar_post"
                                    class="btn-success mr4"
                                    invisible="post_estado != 'Pendiente' or tipo =='otro' or state!= '03_approved'"/>
                            <button string="Cancelar" icon="fa-trash-o" type="object" name="cancelar_post"
                                    class="btn-danger mr4"
                                    invisible="post_estado == 'Pendiente' or post_estado == 'Publicado' or post_estado == 'Procesando' or tipo =='otro'"/>
                            <button string="Revisar" icon="fa-check" type="object" name="revisar_post"
                                    class="btn-success mr4"
                                    invisible="post_estado == 'Pendiente' or post_estado == 'Programado'"/>
                        </div>
                    </div>
                </xpath>
                <xpath expr="//field[@name='tag_ids']" position="after">
                    <field name="fb_post_url" widget="url" invisible="not has_facebook"/>
                    <field name="inst_post_url" widget="url" invisible="not has_instagram"/>
                    <field name="tiktok_post_url" widget="url" invisible="not has_tiktok"/>
                    <field name="linkedin_post_url" widget="url" invisible="not has_linkedin"/>
                    <field name="post_estado" invisible="tipo == 'otro'"/>
                    <div class="d-flex justify-content-end o_state_container" invisible="not active">
                        <field name="state" widget="project_task_state_selection" class="o_task_state_widget"
                               string="Estado de la Tarea"/>
                    </div>
                    <div class="d-flex justify-content-start o_state_container w-100 w-md-50 w-lg-25"
                         invisible="active">
                        <field name="state" widget="project_task_state_selection" class="o_task_state_widget"
                               string="Estado de la Tarea"/>
                    </div>
                </xpath>
                <xpath expr="//page[last()]" position="after">
                    <page string="Debug" name="debug_page">
                        <group>
                            <group string="IDs">
                                <field name="fb_post_id"/>
                                <field name="fb_video_id"/>
                                <field name="inst_post_id"/>
                                <field name="tiktok_post_id"/>
                                <field name="linkedin_post_id"/>
                            </group>
                            <group string="Estados">
                                <field name="fb_estado"/>
                                <field name="ig_estado"/>
                                <field name="tt_estado"/>
                                <field name="li_estado"/>
                            </group>
                            <group string="Errores">
                                <field name="fb_error"/>
                                <field name="ig_error"/>
                                <field name="tt_error"/>
                                <field name="li_error"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
        <record id="gl_geniolibre_task_kanban" model="ir.ui.view">
            <field name="name">GL Task Kanban</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_kanban"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='priority']" position="before">
                    <field name="post_estado" widget="badge" decoration-info="post_estado == 'Procesando'"
                           decoration-warning="post_estado == 'Programado'"
                           decoration-success="post_estado == 'Publicado'"/>
                </xpath>
                <xpath expr="//field[@name='partner_id']" position="replace">
                    <field name="tipo" widget="badge" class="mb-3"/>
                </xpath>
            </field>
        </record>
        <record id="gl_geniolibre_task_list" model="ir.ui.view">
            <field name="name">Taks list</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_tree2"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='activity_ids']" position="attributes">
                    <attribute name="optional">hide</attribute>
                </xpath>
                <xpath expr="//field[@name='date_last_stage_update']" position="attributes">
                    <attribute name="optional">hide</attribute>
                </xpath>
                <xpath expr="//field[@name='project_id']" position="before">

                    <field name="post_estado" widget="badge" string="Estado de Publicación"
                           decoration-info="post_estado == 'Procesando'"
                           decoration-warning="post_estado == 'Programado'"
                           decoration-danger="post_estado == 'Error'"
                           decoration-success="post_estado == 'Publicado'" invisible="tipo == 'otro'"/>
                    <field name="fecha_publicacion" string="Fecha de Publicación" invisible="tipo == 'otro'"/>
                    <field name="red_social_ids" string="Redes Sociales" widget="many2many_tags"
                           options="{'no_create_edit': True}" optional="hide" invisible="tipo == 'otro'"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
