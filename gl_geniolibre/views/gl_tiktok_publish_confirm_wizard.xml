<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_gl_tiktok_publish_confirm_wizard_form" model="ir.ui.view">
            <field name="name">gl.tiktok.publish.confirm.wizard.form</field>
            <field name="model">gl.tiktok.publish.confirm.wizard</field>
            <field name="arch" type="xml">
                <form string="Confirmar accion TikTok">
                    <sheet>
                        <group>
                            <field name="action_type" invisible="1"/>
                            <field name="fecha_publicacion" invisible="action_type != 'schedule'"/>
                            <field name="tiktok_creator_username" readonly="1"/>
                            <field name="tiktok_can_publish_reason" readonly="1" invisible="not tiktok_can_publish_reason"/>
                        </group>
                        <group string="Caption final">
                            <field name="tiktok_caption_preview" widget="text" nolabel="1" readonly="1"/>
                        </group>
                        <group string="Privacidad e interacciones" col="4">
                            <field name="tiktok_privacy_level_label" readonly="1"/>
                            <field name="tiktok_allow_comments" readonly="1"/>
                            <field name="tiktok_allow_duet" readonly="1"/>
                            <field name="tiktok_allow_stitch" readonly="1"/>
                        </group>
                        <group>
                            <field name="tiktok_privacy_note" widget="text" nolabel="1" readonly="1"
                                   invisible="not tiktok_privacy_note"/>
                        </group>
                        <group string="Disclosure comercial" col="4">
                            <field name="tiktok_is_aigc" readonly="1"/>
                            <field name="tiktok_is_commercial" readonly="1"/>
                            <field name="tiktok_commercial_label_preview" readonly="1" invisible="not tiktok_is_commercial"/>
                        </group>
                        <group string="Confirmacion legal">
                            <field name="tiktok_declaration_text" widget="text" nolabel="1" readonly="1"/>
                        </group>
                        <div class="alert alert-info" role="alert">
                            Despues de confirmar la publicacion, TikTok puede tardar unos minutos en procesar el contenido y mostrarlo en el perfil.
                        </div>
                    </sheet>
                    <footer>
                        <button name="action_confirm"
                                string="Confirmar y publicar"
                                type="object"
                                class="btn-primary"
                                invisible="action_type != 'publish'"/>
                        <button name="action_confirm"
                                string="Confirmar programacion"
                                type="object"
                                class="btn-primary"
                                invisible="action_type != 'schedule'"/>
                        <button string="Cancelar" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
