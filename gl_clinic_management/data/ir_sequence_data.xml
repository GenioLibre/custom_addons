<odoo>
    <record id="seq_gl_clinic_patient" model="ir.sequence">
        <field name="name">Paciente</field>
        <field name="code">gl.clinic.patient</field>
        <field name="prefix">PAC-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_gl_clinic_medical_history" model="ir.sequence">
        <field name="name">Historia clínica</field>
        <field name="code">gl.clinic.medical.history</field>
        <field name="prefix">HC-%(year)s-%(month)s%(day)s-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="gl_clinic_dashboard_main" model="gl.clinic.dashboard">
        <field name="name">Panel</field>
    </record>
</odoo>
