<odoo>
    <record id="module_category_gl_clinic" model="ir.module.category">
        <field name="name">Clínica</field>
        <field name="description">Gestión de historias clínicas</field>
        <field name="sequence">25</field>
        <field name="visible" eval="1"/>
    </record>

    <record id="group_gl_clinic_reception" model="res.groups">
        <field name="name">Recepción</field>
        <field name="category_id" ref="module_category_gl_clinic"/>
    </record>

    <record id="group_gl_clinic_doctor" model="res.groups">
        <field name="name">Médico</field>
        <field name="category_id" ref="module_category_gl_clinic"/>
        <field name="implied_ids" eval="[(4, ref('group_gl_clinic_reception'))]"/>
    </record>

    <record id="group_gl_clinic_admin" model="res.groups">
        <field name="name">Administrador clínico</field>
        <field name="category_id" ref="module_category_gl_clinic"/>
        <field name="implied_ids" eval="[(4, ref('group_gl_clinic_doctor'))]"/>
    </record>

    <record id="rule_gl_clinic_patient_company" model="ir.rule">
        <field name="name">Pacientes por empresa</field>
        <field name="model_id" ref="model_gl_clinic_patient"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_gl_clinic_reception')), (4, ref('group_gl_clinic_doctor')), (4, ref('group_gl_clinic_admin'))]"/>
    </record>

    <record id="rule_gl_clinic_history_company" model="ir.rule">
        <field name="name">Historias clínicas por empresa</field>
        <field name="model_id" ref="model_gl_clinic_medical_history"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_gl_clinic_reception')), (4, ref('group_gl_clinic_doctor')), (4, ref('group_gl_clinic_admin'))]"/>
    </record>

    <record id="rule_gl_clinic_medicine_company" model="ir.rule">
        <field name="name">Medicinas por empresa</field>
        <field name="model_id" ref="model_gl_clinic_medicine"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_gl_clinic_reception')), (4, ref('group_gl_clinic_doctor')), (4, ref('group_gl_clinic_admin'))]"/>
    </record>
</odoo>
