<odoo>
    <record id="view_gl_clinic_medicine_list" model="ir.ui.view">
        <field name="name">gl.clinic.medicine.list</field>
        <field name="model">gl.clinic.medicine</field>
        <field name="arch" type="xml">
            <list string="Medicinas">
                <field name="code"/>
                <field name="name"/>
                <field name="notes"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_gl_clinic_medicine_form" model="ir.ui.view">
        <field name="name">gl.clinic.medicine.form</field>
        <field name="model">gl.clinic.medicine</field>
        <field name="arch" type="xml">
            <form string="Medicina">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Nombre de la medicina"/></h1>
                    </div>
                    <group>
                        <field name="code"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="notes" placeholder="Notas internas"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gl_clinic_medicine_search" model="ir.ui.view">
        <field name="name">gl.clinic.medicine.search</field>
        <field name="model">gl.clinic.medicine</field>
        <field name="arch" type="xml">
            <search string="Buscar medicinas">
                <field name="code"/>
                <field name="name"/>
                <filter string="Activas" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archivadas" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_gl_clinic_medicine" model="ir.actions.act_window">
        <field name="name">Medicinas</field>
        <field name="res_model">gl.clinic.medicine</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_gl_clinic_medicine_search"/>
    </record>
</odoo>
