<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--     Extended res_config_settings form view-->
    <record id="gl_chatbot_res_config_settings_view" model="ir.ui.view">
        <field name="name">gl_chatbot_res_config_settings_view.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//form" position="inside">
                <app data-string="AI Chatbot" string="Chatbot" name="Chatbot"
                     logo="/gl_chatbot/static/description/icon.png">
                    <block title="WhatsApp ChatBot">
                        <setting string="Token de verificación de WhatsApp">
                            <field name="whatsapp_verify_token" title="Token de verificación"/>
                        </setting>
                        <setting string="Token API de WhatsApp">
                            <field name="whatsapp_token_api" title="Token API de envío"/>
                        </setting>
                        <setting string="Redirect URI">
                            <field name="whatsapp_redirect_uri" title="Redirect URI"/>
                        </setting>
                    </block>
                    <block title="Conexion con IA">
                        <setting string="Modo de conexión">
                            <field name="chatbot_connection_mode" widget="radio"/>
                        </setting>
                        <setting string="Ruta local del modelo"
                                 help="Ejemplo para Ollama: http://192.168.1.130:11434/api/generate"
                                 invisible="chatbot_connection_mode != 'local'">
                            <field name="chatbot_local_url" placeholder="http://192.168.1.130:11434/api/generate"/>
                        </setting>
                        <setting string="Modelo local"
                                 help="Modelo que se enviará al servidor local, por ejemplo gemma3:4b."
                                 invisible="chatbot_connection_mode != 'local'">
                            <field name="chatbot_local_model" placeholder="gemma3:4b"/>
                        </setting>
                        <setting string="Clave API de OpenAI"
                                 invisible="chatbot_connection_mode != 'openai'">
                            <field name="openai_api_key" password="True" title="Clave API de OpenAI"/>
                        </setting>
                        <setting string="Modelo ChatGPT"
                                 invisible="chatbot_connection_mode != 'openai'">
                            <field name="openai_model" placeholder="gpt-4.1-mini"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
